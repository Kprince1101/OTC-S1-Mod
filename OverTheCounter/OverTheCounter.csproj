<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="LocalPaths.targets" Condition="Exists('LocalPaths.targets')" />

	<PropertyGroup>
		<Configurations>Debug;Release;MonoDebug;MonoRelease</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>OverTheCounter</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>OverTheCounter</AssemblyName> <!-- overridden per-config below -->
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<!-- IL2CPP builds (Debug / Release) -->
	<PropertyGroup Condition="!$(Configuration.StartsWith('Mono'))">
		<TargetFramework>net6.0</TargetFramework>
		<DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
		<GameDllPath>$(ManagedDllPath)</GameDllPath>
		<MLPath>$(MelonLoaderNet6Path)</MLPath>
		<AssemblyName>OverTheCounter.Il2Cpp</AssemblyName>
	</PropertyGroup>

	<!-- Mono build -->
	<PropertyGroup Condition="$(Configuration.StartsWith('Mono'))">
		<TargetFramework>netstandard2.1</TargetFramework>
		<GameDllPath>$(MonoManagedDllPath)</GameDllPath>
		<MLPath>$(MonoMelonLoaderPath)</MLPath>
		<AssemblyName>OverTheCounter.Mono</AssemblyName>
	</PropertyGroup>

	<!-- MonoDebug: add DEBUG constant (MSBuild only auto-defines it for configs named exactly "Debug") -->
	<PropertyGroup Condition="'$(Configuration)' == 'MonoDebug'">
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
	</PropertyGroup>

