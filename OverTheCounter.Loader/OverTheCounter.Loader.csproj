<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../OverTheCounter/LocalPaths.targets" Condition="Exists('../OverTheCounter/LocalPaths.targets')" />

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AssemblyName>OverTheCounter-Loader</AssemblyName>
		<RootNamespace>OverTheCounter.Loader</RootNamespace>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<NoWarn>$(NoWarn);1705;MSB3277</NoWarn>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- The Loader ships as its own package (hdlmrell-OTCLoader) in the r2modman profile,
	     separate from the main mod's package (hdlmrell-OverTheCounter) -- it needs its own
	     output folder, not the main mod's $(ModOutputPath)/$(MonoModOutputPath). Prefer an
	     explicit OTCLoaderOutputPath/MonoOTCLoaderOutputPath if LocalPaths.targets defines
	     one; otherwise derive it automatically by swapping the package folder name, so this
	     works out of the box even for devs who haven't added the new property yet. -->
	<PropertyGroup>
		<OTCLoaderOutputPath Condition="'$(OTCLoaderOutputPath)' == '' And '$(ModOutputPath)' != ''">$(ModOutputPath.Replace('hdlmrell-OverTheCounter', 'hdlmrell-OTCLoader'))</OTCLoaderOutputPath>
		<MonoOTCLoaderOutputPath Condition="'$(MonoOTCLoaderOutputPath)' == '' And '$(MonoModOutputPath)' != ''">$(MonoModOutputPath.Replace('hdlmrell-OverTheCounter', 'hdlmrell-OTCLoader'))</MonoOTCLoaderOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- MelonLoader — available in the game's MelonLoader/net6 directory at runtime -->
		<Reference Include="MelonLoader">
			<HintPath>$(MelonLoaderNet6Path)\MelonLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!-- Mono.Cecil — bundled with MelonLoader, available at runtime without shipping our copy -->
		<Reference Include="Mono.Cecil">
			<HintPath>$(MelonLoaderNet6Path)\Mono.Cecil.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!-- Newtonsoft.Json — bundled with MelonLoader -->
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(MelonLoaderNet6Path)\Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Copy loader to IL2CPP dev profile Plugins folder -->
	<Target Name="CopyToProfile" AfterTargets="Build" Condition="'$(OTCLoaderOutputPath)' != ''">
		<MakeDir Directories="$(OTCLoaderOutputPath)\Plugins" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
		      DestinationFolder="$(OTCLoaderOutputPath)\Plugins" />
	</Target>

	<!-- Also copy loader to Mono dev profile Plugins folder (same DLL works for both CLRs) -->
	<Target Name="CopyToMonoProfile" AfterTargets="Build" Condition="'$(MonoOTCLoaderOutputPath)' != ''">
		<MakeDir Directories="$(MonoOTCLoaderOutputPath)\Plugins" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
		      DestinationFolder="$(MonoOTCLoaderOutputPath)\Plugins" />
	</Target>
</Project>
